# Optional: Google Maps Embed API key (Maps Embed API must be enabled).
# Without this, the site uses a public maps embed URL (no key).
# Restrict the key by HTTP referrer to jabpoint.ee and localhost.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Full-site maintenance screen ("technical works in progress").
# true | 1 | yes | on  → show MaintenanceScreen instead of the site.
# On GitHub: Actions → Deploy to GitHub Pages → Run workflow → maintenance_mode,
# or repo variable MAINTENANCE_MODE=true (Settings → Secrets and variables → Variables).
VITE_MAINTENANCE_MODE=false
